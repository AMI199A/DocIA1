# ==========================================
# Configuración del Entorno - DocIA
# ==========================================

# Configuración de Gemini (obtén la clave en https://aistudio.google.com/apikey)
GEMINI_API_KEY=pega_aqui_tu_clave_de_gemini
GEMINI_MODEL=gemini-2.5-flash

# Configuración de Almacenamiento de Archivos Generados
STORAGE_PATH=./archivos_generados

# Directorio de Conocimiento y Documentos RAG
RAG_DOCS_PATH=./archivos_rag

# Configuración del Servidor Web FastAPI
HOST=127.0.0.1
PORT=8000
